# Скопируйте в .env и при необходимости измените. .env не коммитится (см. .gitignore).

# --- Общее ---
NODE_ENV=development

# --- Веб-слой (Node/Express) ---
WEB_HOST=localhost
WEB_PORT=3000
# Публичный адрес API для браузера (инжектится в страницу как window.API_SERVER).
API_URL=http://localhost:6969
# Origin, которому API разрешает CORS-доступ (вместо '*').
CORS_ORIGIN=http://localhost:3000

# --- Python API (Bottle) ---
# PY_MODE=dev поднимает встроенный сервер; любое другое значение отдаёт WSGI-приложение.
PY_MODE=dev
API_HOST=0.0.0.0
API_PORT=6969
# Токен для админских роутов (например GET /admin/clear/...). Обязательно сменить в проде.
ADMIN_TOKEN=change-me-admin-token

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=exchange

# --- InfluxDB 1.x ---
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_USER=
INFLUX_PASSWORD=

# --- Memcached ---
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
