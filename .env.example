# Скопируйте в .env и при необходимости измените. .env не коммитится (см. .gitignore).

# --- Общее ---
NODE_ENV=development

# --- Веб-слой (Node/Express) ---
WEB_HOST=localhost
WEB_PORT=3000
# Публичный адрес API для браузера (инжектится в страницу как window.API_SERVER).
API_URL=http://localhost:6969
# Origin, которому API разрешает CORS-доступ (вместо '*').
CORS_ORIGIN=http://localhost:3000

# --- Python API (Bottle) ---
# PY_MODE=dev поднимает встроенный сервер; любое другое значение отдаёт WSGI-приложение.
PY_MODE=dev
API_HOST=0.0.0.0
API_PORT=6969
# Токен для админских роутов (например GET /admin/clear/...). Обязательно сменить в проде.
ADMIN_TOKEN=change-me-admin-token

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
# В проде обязательно сменить на собственные креды (не использовать dev-значения).
MONGO_USER=yzoz_admin
MONGO_PASSWORD=change-me-mongo-password
MONGO_DB=exchange
# Таймаут выбора сервера (мс): как быстро признать Mongo недоступным (graceful).
MONGO_SELECT_TIMEOUT=2000

# --- InfluxDB 1.x ---
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_USER=yzoz_admin
INFLUX_PASSWORD=change-me-influx-password
# Таймаут HTTP-запроса к InfluxDB (сек).
INFLUX_TIMEOUT=2

# --- Memcached ---
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# --- Graceful-поведение ---
# Как часто (сек) перепроверять доступность хранилищ для /health и 503-проверок.
STORAGE_PROBE_TTL=10

# --- Rate-limit публичных входов (/signup, /order, /user) ---
# RATE_LIMIT=0 отключает; RATE_WINDOW — окно в секундах; RATE_MAX — запросов на IP за окно.
RATE_LIMIT=1
RATE_WINDOW=60
RATE_MAX=120
